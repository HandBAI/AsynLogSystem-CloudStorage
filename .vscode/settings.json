{
    // 自动保存：延迟1秒
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    // ==================== 全局编码 UTF-8 ====================
    "files.encoding": "utf8",
    // ==================== 全局换行符 LF ====================
    "files.eol": "\n",
    // ==================== 保存自动格式化（可选） ====================
    "editor.formatOnSave": true,
    "editor.trimAutoWhitespace": true,
    // 启用 C/C++ 扩展
    "C_Cpp.formatting": "clangFormat",
    // C++ 默认格式化工具设为 C/C++ 扩展
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    // clang-format 核心：命名空间不缩进
    // "C_Cpp.clang_format_style": "{ IndentWidth: 4, NamespaceIndentation: None, AccessModifierOffset: -4, BreakBeforeBraces: Custom, BraceWrapping: { AfterFunction: true, AfterClass: true, AfterNamespace: true, AfterControlStatement: false } }"
    "C_Cpp.clang_format_style": "{ColumnLimit: 0,NamespaceIndentation: None, IndentWidth: 4, AccessModifierOffset: -4, BreakBeforeBraces: Custom, BraceWrapping: { AfterFunction: true, AfterControlStatement: false }}"
}